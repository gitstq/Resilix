{
  "name": "aggressive",
  "timeoutMs": 3000,
  "limiter": {
    "algorithm": "token-bucket",
    "capacity": 1200,
    "refillPerSec": 900
  },
  "bulkhead": {
    "maxConcurrent": 64,
    "maxQueue": 128,
    "queueTimeoutMs": 400
  },
  "breaker": {
    "windowMs": 5000,
    "bucketCount": 10,
    "minimumCalls": 30,
    "failureRateThreshold": 0.7,
    "slowCallRateThreshold": 1,
    "slowCallMs": 2000,
    "openWaitMs": 3000,
    "halfOpenMaxCalls": 5
  },
  "retry": {
    "maxAttempts": 5,
    "backoff": {
      "baseMs": 25,
      "multiplier": 2,
      "maxMs": 2000,
      "jitter": "full"
    },
    "retryBudgetRatio": 0.4,
    "retryBudgetWindowMs": 10000,
    "maxElapsedMs": 1500
  },
  "hedge": {
    "delayMs": 300,
    "maxHedges": 1
  }
}